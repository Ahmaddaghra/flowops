# PostgreSQL Container & Application Database Configuration
POSTGRES_DB=flowops
POSTGRES_USER=flowops
POSTGRES_PASSWORD=flowops_dev_pass_123

# Container administrative superuser (used only during initial container bootstrap)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_password

# Port mapping for local development
POSTGRES_PORT=5432

# Application connection string (used by backend API)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=flowops;Username=flowops;Password=flowops_dev_pass_123
